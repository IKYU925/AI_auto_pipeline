# n8n이 FastAPI 호출 시 X-Automation-Token 헤더로 보내는 값
AUTOMATION_TOKEN=change-me

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge

# 임베딩: fastembed(로컬, 비용 0) | openai | hash(테스트용)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# 모델 분리: 분류는 경량, 원인 분석과 수정 코드 생성은 고성능
ANTHROPIC_API_KEY=
LIGHT_MODEL=anthropic:claude-haiku-5-5
HEAVY_MODEL=anthropic:claude-opus-5-5
# 100만 토큰당 [입력, 출력] USD. 예시 값이므로 실제 요금표로 맞춘다
MODEL_PRICES={"anthropic:claude-haiku-5-5":[1.0,5.0],"anthropic:claude-opus-5-5":[5.0,25.0]}
INCIDENT_BUDGET_USD=1.0

# 수정안 검증 대상 저장소(컨테이너 안 경로)
TARGET_REPO_PATH=/repo
MAX_FIX_ATTEMPTS=3
TEST_TIMEOUT_SEC=300

# 결과를 Slack 스레드에 회신할 Bot 토큰(chat:write 권한). 비우면 로그만 남긴다
SLACK_BOT_TOKEN=

# n8n
N8N_ENCRYPTION_KEY=change-me-too
