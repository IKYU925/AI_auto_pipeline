      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT i.created_at AS \"접수\", i.id AS \"장애\", i.source AS \"입구\", coalesce(i.alertname, '') AS \"알림\", i.tenant AS \"고객사\", i.service AS \"서비스\", coalesce(i.category, '') AS \"분류\", i.status AS \"결과\", i.attempts AS \"시도\", round(extract(epoch FROM i.finished_at - i.created_at)::numeric, 1) AS \"처리(초)\", (SELECT round(sum(usd), 4) FROM llm_calls c WHERE c.incident_id = i.id) AS \"비용($)\" FROM incidents i WHERE $__timeFilter(i.created_at) AND i.tenant IN ($tenant) ORDER BY i.created_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
