  "editable": true,
  "panels": [
    {
      "id": 101,
      "title": "웹훅 전달",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * (1 - (sum(increase(alertmanager_notifications_failed_total{integration=\"webhook\"}[$__range])) or vector(0)) / sum(increase(alertmanager_notifications_total{integration=\"webhook\"}[$__range])))",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "SLI. Alertmanager가 자동화로 보낸 웹훅 중 성공한 비율(커버리지의 근사값, docs/sli.md)"
    },
    {
      "id": 102,
      "title": "3분 안 회신(코드 버그)",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE extract(epoch FROM to_timestamp(report_ts::numeric) - coalesce(occurred_at, created_at)) <= 180) / NULLIF(count(*), 0) AS \"비율\" FROM incidents WHERE needs_code_fix AND source = 'alertmanager' AND report_ts IS NOT NULL AND $__timeFilter(created_at) AND tenant IN ($tenant)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "SLI. 코드 버그(코드 수정이 필요하다고 분류된 장애) 중 알림 시작부터 3분 안에 Slack 회신한 비율. 3분은 임시 기준(docs/sli.md)"
    },
    {
      "id": 103,
      "title": "6분 안 회신(설정·인프라)",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE extract(epoch FROM to_timestamp(report_ts::numeric) - coalesce(occurred_at, created_at)) <= 360) / NULLIF(count(*), 0) AS \"비율\" FROM incidents WHERE NOT needs_code_fix AND source = 'alertmanager' AND report_ts IS NOT NULL AND $__timeFilter(created_at) AND tenant IN ($tenant)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "SLI. 설정·인프라 장애(코드 수정이 필요 없다고 분류된 장애) 중 알림 시작부터 6분 안에 Slack 회신한 비율. 6분은 임시 기준(docs/sli.md)"
    },
    {
      "id": 104,
      "title": "처리 성공",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE status IN ('resolved', 'escalated', 'no_code_fix') AND report_ts IS NOT NULL) / NULLIF(count(*), 0) AS \"비율\" FROM incidents WHERE created_at < now() - interval '15 minutes' AND $__timeFilter(created_at) AND tenant IN ($tenant)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "SLI. 접수 후 15분 지난 장애 중 끝까지 처리돼 회신한 비율. failed, budget_exceeded, 회신 없음은 실패"
    },
    {
      "id": 105,
      "title": "회신 시간 중앙값",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM to_timestamp(report_ts::numeric) - coalesce(occurred_at, created_at))) FILTER (WHERE needs_code_fix) AS \"코드 버그\", percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM to_timestamp(report_ts::numeric) - coalesce(occurred_at, created_at))) FILTER (WHERE NOT needs_code_fix) AS \"설정·인프라\" FROM incidents WHERE source = 'alertmanager' AND report_ts IS NOT NULL AND $__timeFilter(created_at) AND tenant IN ($tenant)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "알림 시작부터 Slack 회신까지 경로별 중앙값"
    },
    {
      "id": 106,
      "title": "장애당 LLM 비용(가드레일)",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(usd) / NULLIF(count(DISTINCT incident_id), 0) AS \"비용\" FROM llm_calls WHERE $__timeFilter(created_at) AND incident_id IN (SELECT id FROM incidents WHERE tenant IN ($tenant))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "SLI 아님. 장애당 평균 LLM 비용(운영 제약)"
    },
    {
      "id": 107,
      "title": "장애별 시간 분해(최근 15건)",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT * FROM (SELECT to_char(created_at AT TIME ZONE 'Asia/Seoul', 'MM-DD HH24:MI') || ' ' || alertname AS \"장애\", extract(epoch FROM created_at - occurred_at) AS \"전달\", extract(epoch FROM finished_at - created_at) AS \"처리\", extract(epoch FROM to_timestamp(report_ts::numeric) - finished_at) AS \"회신\", created_at FROM incidents WHERE source = 'alertmanager' AND report_ts IS NOT NULL AND occurred_at IS NOT NULL AND $__timeFilter(created_at) AND tenant IN ($tenant) ORDER BY created_at DESC LIMIT 15) t ORDER BY created_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "created_at"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "stacking": "normal",
        "xField": "장애",
        "orientation": "horizontal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "알림 시작부터 수신(전달), 수신부터 완료(처리), 완료부터 Slack 회신까지. 장애 발생부터 알림까지(감지)는 실험에서만 잴 수 있다"
    },
    {
      "id": 7,
      "title": "일별 장애 수와 결과",
      "type": "barchart",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(date_trunc('day', created_at), 'MM-DD') AS \"날짜\", count(*) FILTER (WHERE status = 'resolved') AS \"자동 수정\", count(*) FILTER (WHERE status = 'no_code_fix') AS \"런북 안내\", count(*) FILTER (WHERE status = 'escalated') AS \"사람 확인\", count(*) FILTER (WHERE status = 'failed') AS \"실패\", count(*) FILTER (WHERE status NOT IN ('resolved', 'no_code_fix', 'escalated', 'failed')) AS \"처리 중\" FROM incidents WHERE $__timeFilter(created_at) AND tenant IN ($tenant) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "stacking": "normal",
        "xField": "날짜",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 12,
      "title": "최근 장애",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 10
